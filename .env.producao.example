# Modelo do `.env` de produção — copie para `.env` NO SERVIDOR e preencha.
# O `.env` real nunca é versionado (ver .gitignore).
#
#   cp .env.producao.example .env && nano .env
#
# Gere os dois segredos com:
#   openssl rand -base64 36

# O endereço público. Sem domínio próprio, use sslip.io: ele resolve o IP que está no
# próprio nome. Pegue o IP da SUA VPS no painel, troque os pontos por traços e cole
# `.sslip.io` no fim — um IP 203.0.113.10 viraria 203-0-113-10.sslip.io (esse é um IP de
# exemplo da RFC 5737, reservado para documentação; não use ele). Serve para o Caddy tirar certificado de verdade do Let's Encrypt — e HTTPS
# real é requisito, não capricho: `navigator.geolocation` não existe fora de contexto
# seguro, e sem ela a presença verificada inteira (ADR-009) cai em "sem-suporte".
# Troque por domínio próprio depois: muda esta linha e sobe o Caddy de novo.
DOMINIO=SEU-IP-COM-TRACOS.sslip.io

# Para onde o Let's Encrypt manda aviso de vencimento. Obrigatório: sem ele o Caddy
# nem sobe, o que é melhor do que descobrir em 90 dias.
ACME_EMAIL=voce@exemplo.com

POSTGRES_USER=boraroles
POSTGRES_PASSWORD=TROQUE-ME
POSTGRES_DB=boraroles

# O default em backend/src/boraroles/config.py é "change-me-to-a-long-random-string"
# e está no repositório — ou seja, é público. Com ele, qualquer um forja um token de
# curador.
JWT_SECRET=TROQUE-ME

# Chute de escritório que o R8 vai calibrar em campo (item 3 do R8). Fica no ambiente
# para poder ser ajustado sem rebuild — é só reiniciar a api.
PRESENCA_RAIO_PADRAO_METROS=150
